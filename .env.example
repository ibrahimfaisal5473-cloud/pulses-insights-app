# Copy to .env.local and adjust as needed.

# Secret used to sign the mock session JWT. Use a long, random string.
SESSION_SECRET=replace-with-a-long-random-string

# Demo login credentials for the mock auth.
AUTH_USERNAME=admin
AUTH_PASSWORD=password123

# PostgreSQL connection string. Supabase: Project Settings -> Database ->
# Connection string -> Session pooler (port 5432). Use the session pooler or
# the direct connection, not the transaction pooler on 6543 — a long-lived
# server-side pool is what this app opens, and that is what session mode is.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Same Supabase URL, read by db/supabase.sh when loading the data. Keeping it
# separate lets DATABASE_URL point at a local database while migrating.
SUPABASE_DATABASE_URL=

# Optional: path to the Supabase CA certificate (Project Settings -> Database
# -> SSL configuration). Set it to verify the server's identity rather than
# only encrypting the connection.
# DATABASE_CA_CERT=
# Shared secret required by the pulse ingestion endpoint.
INGEST_API_KEY=replace-with-a-long-random-string
